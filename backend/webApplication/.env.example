SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/welo_db
SPRING_DATASOURCE_USERNAME=welo_user
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DOCKER_COMPOSE_ENABLED=false
JWT_SECRET=replace-with-a-base64-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
# false for local HTTP development; true for production HTTPS
REFRESH_COOKIE_SECURE=false

VERIFICATION_CODE_LENGTH = 6
VERIFICATION_CODE_EXPIRATION_MIN=15
VERIFICATION_RESEND_COOLDOWN_MINUTES = 1
VERIFICATION_CODE_MAX_ATTEMPTS=5
ALPHANUMERIC_CHARACTERS="ABCDEFGHJKLMNPQRSTUVWXYZ23456789"

# leave RESEND_API_KEY blank to print the OTP to the backend console instead of emailing it
RESEND_API_KEY=
MAIL_FROM=no-reply@your-verified-domain.com